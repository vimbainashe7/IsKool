# Root orchestration defaults for local development only.
# Supabase CLI owns local PostgreSQL on port 54322.
# Each API keeps its own service-specific .env.example.

COMPOSE_PROJECT_NAME=aps-sams

REDIS_PORT=6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
APS_STORAGE_BUCKET=aps-local
SAMS_STORAGE_BUCKET=sams-local
