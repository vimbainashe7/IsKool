generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  logoDataUrl String? @map("logo_data_url")
  logoPresent Boolean @default(false) @map("logo_present")
  brandingVersion Int @default(1) @map("branding_version")
  id          String       @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  name        String
  status      String       @default("active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  students Student[]
  guardians Guardian[]
  academicYears AcademicYear[]
  memberships Membership[]
  authSessions AuthSession[]
  auditEvents  AuditEvent[]

  @@map("schools")
}

model User {
  profileVersion Int @default(1) @map("profile_version")
  id              String           @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  email           String
  emailNormalized String           @map("email_normalized")
  displayName     String           @map("display_name")
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]
  credential      UserCredential?
  authSessions    AuthSession[]
  continuations   AuthLoginContinuation[]
  auditEvents     AuditEvent[]

  @@unique([email], map: "users_email_unique")
  @@unique([emailNormalized], map: "users_email_normalized_unique")
  @@map("users")
}

model Membership {
  id              String           @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "memberships_user_id_fkey")
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "memberships_school_id_fkey")
  membershipRoles MembershipRole[]
  authSessions    AuthSession[]
  auditEvents     AuditEvent[]

  studentAccount Student? @relation("StudentAccount")
  teachingAssignments ClassTeacher[]
    authoredAssignments Assignment[]
  @@unique([id,schoolId], map:"memberships_id_school_unique")
  @@unique([userId, schoolId], map: "memberships_user_school_unique")
  @@index([userId], map: "memberships_user_id_idx")
  @@index([schoolId,status,id],map:"memberships_school_status_idx")
  @@index([schoolId], map: "memberships_school_id_idx")
  @@index([userId, schoolId], map: "memberships_user_school_idx")
  @@map("memberships")
}

model Role {
  id              String           @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  key             String
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  membershipRoles MembershipRole[]

  @@unique([key], map: "roles_key_unique")
  @@map("roles")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "membership_roles_membership_id_fkey")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "membership_roles_role_id_fkey")

  @@id([membershipId, roleId])
  @@index([membershipId], map: "membership_roles_membership_id_idx")
  @@index([roleId], map: "membership_roles_role_id_idx")
  @@map("membership_roles")
}

model UserCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_credentials_user_id_fkey")

  @@map("user_credentials")
}

model AuthSession {
  id              String             @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  schoolId        String             @map("school_id") @db.Uuid
  membershipId    String             @map("membership_id") @db.Uuid
  refreshFamilyId String             @default(dbgenerated("extensions.gen_random_uuid()")) @map("refresh_family_id") @db.Uuid
  allowedScopes   String[]           @map("allowed_scopes")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?          @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason    String?            @map("revoke_reason")
  reuseDetectedAt DateTime?          @map("reuse_detected_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_user_id_fkey")
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "auth_sessions_school_id_fkey")
  membership      Membership         @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "auth_sessions_membership_id_fkey")
  refreshTokens   AuthRefreshToken[]

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([membershipId], map: "auth_sessions_membership_id_idx")
  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_active_idx")
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id              String              @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  sessionId       String              @map("session_id") @db.Uuid
  tokenDigest     String              @map("token_digest")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?           @map("consumed_at") @db.Timestamptz(6)
  replacedById    String?             @map("replaced_by_id") @db.Uuid
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamptz(6)
  reuseDetectedAt DateTime?           @map("reuse_detected_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session         AuthSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_refresh_tokens_session_id_fkey")
  replacedBy      AuthRefreshToken?   @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "auth_refresh_tokens_replaced_by_id_fkey")
  replacements    AuthRefreshToken[]  @relation("RefreshTokenReplacement")

  @@unique([tokenDigest], map: "auth_refresh_tokens_digest_unique")
  @@index([sessionId], map: "auth_refresh_tokens_session_id_idx")
  @@map("auth_refresh_tokens")
}

model AuthLoginContinuation {
  id             String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  verifierDigest String    @map("verifier_digest")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_login_continuations_user_id_fkey")

  @@unique([verifierDigest], map: "auth_login_continuations_digest_unique")
  @@index([userId], map: "auth_login_continuations_user_id_idx")
  @@map("auth_login_continuations")
}

model AuditEvent {
  id                String     @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  actorUserId       String     @map("actor_user_id") @db.Uuid
  actorMembershipId String     @map("actor_membership_id") @db.Uuid
  schoolId          String     @map("school_id") @db.Uuid
  action            String
  entityType        String     @map("entity_type")
  entityId          String     @map("entity_id")
  beforeValue       Json?      @map("before_value")
  afterValue        Json?      @map("after_value")
  requestId         String     @map("request_id")
  reason            String?
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor             User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_events_actor_user_id_fkey")
  actorMembership   Membership @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_events_actor_membership_id_fkey")
  school            School     @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_events_school_id_fkey")

  @@index([schoolId, createdAt(sort: Desc)], map: "audit_events_school_created_at_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_events_actor_created_at_idx")
  @@index([entityType, entityId], map: "audit_events_entity_idx")
  @@index([requestId], map: "audit_events_request_id_idx")
  @@map("audit_events")
}

model Student {
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  admissionNumber String @map("admission_number")
  givenName String @map("given_name")
  familyName String @map("family_name")
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school School @relation(fields:[schoolId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  guardians StudentGuardian[]
  enrollments Enrollment[]
  membershipId String? @map("membership_id") @db.Uuid
  account Membership? @relation("StudentAccount",fields:[membershipId,schoolId],references:[id,schoolId],onDelete:Restrict,onUpdate:NoAction,map:"students_membership_school_fkey")
  @@unique([id,schoolId])
  @@unique([membershipId,schoolId],map:"students_membership_school_unique")
  @@unique([schoolId,admissionNumber])
  @@index([schoolId,id], map:"students_school_id_idx")
  @@index([schoolId,familyName,givenName,id], map:"students_school_name_idx")
  @@map("students")
}
model Guardian {
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  fullName String @map("full_name")
  email String
  phone String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school School @relation(fields:[schoolId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  students StudentGuardian[]
  @@unique([id,schoolId])
  @@unique([schoolId,email])
  @@map("guardians")
}
model StudentGuardian {
  studentId String @map("student_id") @db.Uuid
  guardianId String @map("guardian_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  relationship String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student Student @relation(fields:[studentId,schoolId], references:[id,schoolId], onDelete:Restrict, onUpdate:NoAction)
  guardian Guardian @relation(fields:[guardianId,schoolId], references:[id,schoolId], onDelete:Restrict, onUpdate:NoAction)
  @@id([studentId,guardianId])
  @@index([schoolId,guardianId],map:"student_guardians_guardian_idx")
  @@map("student_guardians")
}
model AcademicYear {
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  label String
  startsOn DateTime @map("starts_on") @db.Date
  endsOn DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school School @relation(fields:[schoolId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  terms AcademicTerm[]
  classes SchoolClass[]
  @@unique([id,schoolId])
  @@unique([schoolId,label])
  @@map("academic_years")
}
model AcademicTerm {
  assignments Assignment[]
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  label String
  startsOn DateTime @map("starts_on") @db.Date
  endsOn DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  year AcademicYear @relation(fields:[academicYearId,schoolId], references:[id,schoolId], onDelete:Restrict, onUpdate:NoAction)
  enrollments Enrollment[]
  @@unique([id,schoolId,academicYearId])
  @@unique([schoolId,academicYearId,label])
  @@map("academic_terms")
}
model SchoolClass {
  assignments Assignment[]
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  name String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  year AcademicYear @relation(fields:[academicYearId,schoolId], references:[id,schoolId], onDelete:Restrict, onUpdate:NoAction)
  enrollments Enrollment[]
  teachers ClassTeacher[]
  @@unique([id,schoolId,academicYearId])
  @@unique([schoolId,academicYearId,name])
  @@index([schoolId,id],map:"classes_school_id_idx")
  @@map("classes")
}
model Enrollment {
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  academicTermId String @map("academic_term_id") @db.Uuid
  status String @default("pending")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(6)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student Student @relation(fields:[studentId,schoolId], references:[id,schoolId], onDelete:Restrict, onUpdate:NoAction)
  schoolClass SchoolClass @relation(fields:[classId,schoolId,academicYearId], references:[id,schoolId,academicYearId], onDelete:Restrict, onUpdate:NoAction)
  term AcademicTerm @relation(fields:[academicTermId,schoolId,academicYearId], references:[id,schoolId,academicYearId], onDelete:Restrict, onUpdate:NoAction)
  @@index([schoolId,studentId,enrolledAt(sort:Desc),id],map:"enrollments_student_history_idx")
  @@index([schoolId,classId,academicTermId,status],map:"enrollments_class_status_idx")
  @@map("enrollments")
}

model ClassTeacher {
  classId String @map("class_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  schoolClass SchoolClass @relation(fields:[classId,schoolId,academicYearId],references:[id,schoolId,academicYearId],onDelete:Restrict,onUpdate:NoAction)
  membership Membership @relation(fields:[membershipId,schoolId],references:[id,schoolId],onDelete:Restrict,onUpdate:NoAction)
  @@id([classId,membershipId])
  @@index([schoolId,membershipId,status,classId],map:"class_teachers_membership_idx")
  @@map("class_teachers")
}

model Assignment {
  id String @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  academicTermId String @map("academic_term_id") @db.Uuid
  authorMembershipId String @map("author_membership_id") @db.Uuid
  title String
  instructions String
  totalMarks Decimal @map("total_marks") @db.Decimal(6,2)
  dueAt DateTime @map("due_at") @db.Timestamptz(6)
  status String @default("draft")
  version Int @default(1)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  schoolClass SchoolClass @relation(fields:[classId,schoolId,academicYearId],references:[id,schoolId,academicYearId],onDelete:Restrict,onUpdate:NoAction)
  term AcademicTerm @relation(fields:[academicTermId,schoolId,academicYearId],references:[id,schoolId,academicYearId],onDelete:Restrict,onUpdate:NoAction)
  author Membership @relation(fields:[authorMembershipId,schoolId],references:[id,schoolId],onDelete:Restrict,onUpdate:NoAction)
  @@index([schoolId,authorMembershipId,id],map:"assignments_teacher_page_idx")
  @@index([schoolId,authorMembershipId,status],map:"assignments_teacher_status_idx")
  @@index([schoolId,classId,academicTermId,status,dueAt,id],map:"assignments_class_feed_idx")
  @@map("assignments")
}
