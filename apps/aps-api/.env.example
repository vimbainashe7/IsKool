NODE_ENV=development
ISKOOL_ENVIRONMENT=development
SERVICE_NAME=aps-api
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ISSUER=aps-api
JWT_AUDIENCE=aps
JWT_SCOPE=aps
JWT_PRIVATE_KEY_PEM="replace-with-aps-rs256-private-key"
JWT_PUBLIC_KEY_PEM="replace-with-aps-rs256-public-key"
JWT_KEY_ID=aps-local-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SAMS_INTERNAL_BASE_URL=http://127.0.0.1:3003/internal/v1
SAMS_INTERNAL_ENABLED=false
# Enable with a matching private service key in both APIs. Never use a user password.
SAMS_INTERNAL_SERVICE_KEY=
SAMS_INTERNAL_TIMEOUT_MS=2000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=aps-local
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_FORCE_PATH_STYLE=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=debug
